{
  "name": "@an1mbyt3/editor",
  "private": true,
  "version": "0.1.0",
  "description": "Tauri 2 + React/TypeScript desktop editor. See AN1MBYT3_BUILD_PLAN.md §10 Phase 4 and §15 (design direction).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && npm run build:player && vite build",
    "build:player": "vite build --config vite.player.config.ts && vite build --config vite.embed.config.ts",
    "build:embed": "vite build --config vite.embed.config.ts",
    "build:runner": "cargo build -p an1mbyt3-runner --release",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@scratch/paper": "^0.11.20221201200345",
    "@scratch/scratch-svg-renderer": "^13.7.3",
    "@tauri-apps/api": "^2",
    "blockly": "^13.3.0",
    "classnames": "^2.5.1",
    "gifenc": "^1.0.3",
    "keymirror": "^0.1.1",
    "lodash.bindall": "^4.4.0",
    "lodash.omit": "^4.18.0",
    "mediabunny": "^1.61.3",
    "minilog": "^3.1.0",
    "monaco-editor": "^0.56.0",
    "parse-color": "^1.0.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-intl": "^6.8.9",
    "react-intl-redux": "^2.4.1",
    "react-redux": "^8.1.3",
    "react-responsive": "^9.0.2",
    "react-style-proptype": "^3.2.2",
    "react-tooltip": "^4.5.1",
    "redux": "^4.2.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10",
    "postcss": "^8",
    "postcss-import": "^15.1.0",
    "postcss-simple-vars": "^7.0.1",
    "tailwindcss": "^3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
